# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# スクリーンショット（ループの自己確認用）
/.shots

# 写真の評価セット（本物の写真。家や人が写るのでリポジトリに入れない）
/eval/photos/

# 並行作業用の作業コピー（Claude Code）
/.claude/worktrees/

# テストモードの結果（npm run sim の書き出し）
/.sim

# 点検ループの結果（npm run tenken の書き出し）
/.tenken
