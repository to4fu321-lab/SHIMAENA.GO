# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# スクリーンショット（ループの自己確認用）
/.shots

# 写真の評価セット（本物の写真。家や人が写るのでリポジトリに入れない）
/eval/photos/

# 並行作業用の作業コピー（Claude Code）
/.claude/worktrees/

# テストモードの結果（npm run sim の書き出し）
/.sim

# 点検ループの結果（npm run tenken の書き出し）
/.tenken
.voice-samples/

# デモ動画の中間ファイル（scripts/demo-video）
/.video

# 紹介動画 v3 の仮の声の道具（scripts/video-v3/tts/setup.sh が作る。大きいので入れない）
/scripts/video-v3/tts/venv/
/scripts/video-v3/tts/models/
/scripts/video-v3/tts/.cache/
/scripts/video-v3/tts/out/
/scripts/video-v3/tts/__pycache__/
